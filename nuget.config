<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> so a machine- or runner-level config cannot introduce a third source and
       reintroduce NU1507. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/cyclotron-azure/index.json" />
  </packageSources>

  <!-- Central package management requires every source to be mapped once more than one is
       defined. The mapping is also a supply-chain control: a package named Cyclotron.* can only
       ever come from our own feed, never from a nuget.org squatter, and nothing else is ever
       requested from GitHub Packages.

       Because of that second rule, a normal local build never contacts GitHub Packages at all —
       it builds sibling libraries from source (UseProjectReferences defaults to true), so no
       Cyclotron.* package is ever requested and no credentials are needed. Only packing
       (-p:UseProjectReferences=false) requires access to the feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Cyclotron.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
