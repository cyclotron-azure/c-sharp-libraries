<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cyclotron.Graph.Mail</RootNamespace>
    <AssemblyName>Cyclotron.Graph.Mail</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="NuGet packaging">
    <PackageId>Cyclotron.Graph.Mail</PackageId>
    <Version>0.1.0</Version>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>microsoft-graph;graph-api;mail;messages;delta</PackageTags>
    <Description>Microsoft Graph mail client for the Cyclotron.Graph.* family — messages, well-known folders, and delta queries. Install this package directly; it brings in Cyclotron.Graph.Core transitively, so a mail consumer's project only needs to reference Cyclotron.Graph.Mail.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyclotron.Graph.Core\Cyclotron.Graph.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
